{
  "schema": "lynceus-api-config/1",
  "target": "url",
  "base_url": "http://127.0.0.1:8787",
  "allow_remote": false,
  "openapi": {
    "file": "docs/openapi.json"
  },
  "max_examples": 30,
  "auth": {
    "header": "Authorization",
    "value_env": "LYNCEUS_API_AUTH_VALUE"
  },
  "exclude": [
    {
      "method": "GET",
      "path": "/api/account/api-tokens"
    },
    {
      "method": "POST",
      "path": "/api/account/api-tokens"
    },
    {
      "method": "DELETE",
      "path": "/api/account/api-tokens/{id}"
    },
    {
      "method": "POST",
      "path": "/api/dmarc-ingest"
    },
    {
      "method": "GET",
      "path": "/api/account/export"
    },
    {
      "method": "GET",
      "path": "/api/account/login-history"
    },
    {
      "method": "GET",
      "path": "/api/account/sessions"
    },
    {
      "method": "PATCH",
      "path": "/api/account/profile"
    },
    {
      "method": "POST",
      "path": "/api/account/delete-request"
    },
    {
      "method": "GET",
      "path": "/api/auth/mfa/status"
    },
    {
      "method": "POST",
      "path": "/api/auth/mfa/disable"
    },
    {
      "method": "POST",
      "path": "/api/auth/mfa/setup"
    },
    {
      "method": "POST",
      "path": "/api/auth/mfa/verify-setup"
    },
    {
      "method": "GET",
      "path": "/api/portfolio/alerts"
    },
    {
      "method": "GET",
      "path": "/api/portfolio/overview"
    },
    {
      "method": "GET",
      "path": "/api/portfolio/trends"
    },
    {
      "method": "GET",
      "path": "/api/portfolio/workspaces"
    },
    {
      "method": "GET",
      "path": "/api/scans/{scanId}/executive-report-v2"
    },
    {
      "method": "GET",
      "path": "/api/scans/{scanId}/report"
    },
    {
      "method": "GET",
      "path": "/api/scans/{scanId}/report/pdf"
    },
    {
      "method": "GET",
      "path": "/api/scans/{scanId}/snapshot"
    },
    {
      "method": "GET",
      "path": "/api/workspaces/{workspaceId}"
    },
    {
      "method": "GET",
      "path": "/api/workspaces/{workspaceId}/domains"
    },
    {
      "method": "GET",
      "path": "/api/workspaces/{workspaceId}/domains/{domain}/dmarc-summary"
    },
    {
      "method": "GET",
      "path": "/api/workspaces/{workspaceId}/exposure/feed"
    },
    {
      "method": "GET",
      "path": "/api/workspaces/{workspaceId}/reports"
    },
    {
      "method": "POST",
      "path": "/api/workspaces/{workspaceId}/brand/discovery"
    },
    {
      "method": "POST",
      "path": "/api/billing/checkout"
    },
    {
      "method": "POST",
      "path": "/api/billing/portal"
    }
  ]
}
