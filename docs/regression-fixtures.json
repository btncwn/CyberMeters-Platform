      "note": "CSP is present (even if weak) so header_missing_content_security_policy must NOT be generated. Weak CSP is evidence-only in v4 \u2014 no score deduction."
    },
    {
      "scenario": "canonical_url_uncertain",
      "description": "Domain where HTTP probing is blocked (bot protection) \u2014 canonical URL confidence should be medium or low, finding confidence suppressed",
      "mock_modules": {
        "ssl": {
          "https_available": true,
          "http_redirects_to_https": null,
          "http_redirect_chain": {
            "http_redirect_validated": false
