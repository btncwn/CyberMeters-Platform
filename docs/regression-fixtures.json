    {
      "scenario": "resolver_disagreement",
      "description": "DNS cross-check returns different A records from Cloudflare vs Google \u2014 resolver agreement score should be < 100 and resolver_disagreement should be true in evidence metadata, but no finding is generated",
      "mock_modules": {
        "dns": {
          "resolves": true,
          "cross_checks": {
            "a": {
              "cloudflare_resolver": { "resolver": "cloudflare", "status": "ok", "returned_records": ["1.2.3.4"] },
              "google_resolver": { "resolver": "google", "status": "ok", "returned_records": ["5.6.7.8"] },
              "resolver_disagreement": true,
              "resolver_agreement_score": 0
            }
          }
        },
        "ssl": { "https_available": true, "http_redirects_to_https": true },
        "headers": {
          "accessible": true,
          "final_https": true,
          "validation_uncertain": false,
          "status_code": 200,
          "values": {
            "strict-transport-security": "max-age=31536000; includeSubDomains",
            "content-security-policy": "default-src 'self'",
            "x-frame-options": "DENY",
            "x-content-type-options": "nosniff",
            "referrer-policy": "no-referrer",
            "permissions-policy": "geolocation=()"
          }
        },
        "email_security": {
          "spf": { "present": true },
          "dmarc": { "present": true, "policy": "reject" },
          "dkim": { "present": true }
        }
      },
      "expected_finding_ids_absent": ["dns_no_resolution"],
      "note": "Resolver disagreement populates evidence metadata only. Domain resolves so dns_no_resolution must not be generated. Resolver disagreement does not create any scored finding."
    },
    {
      "scenario": "header_weak_hsts",
      "description": "HSTS header present but max-age is below the 180-day (15,552,000s) threshold",
      "mock_modules": {
        "dns": {
          "resolves": true
        },
        "ssl": {
          "https_available": true,
          "http_redirects_to_https": true
        },
        "headers": {
          "accessible": true,
          "final_https": true,
          "validation_uncertain": false,
          "status_code": 200,
          "values": {
            "strict-transport-security": "max-age=3600",
            "content-security-policy": "default-src 'self'",
            "x-frame-options": "DENY",
            "x-content-type-options": "nosniff",
            "referrer-policy": "no-referrer",
            "permissions-policy": "geolocation=()"
          },
          "header_strength": {
            "strict-transport-security": {
              "status": "weak",
              "details": "max-age=3600 \u2014 below recommended minimum of 15,552,000 (180 days)"
            }
          }
        },
        "email_security": {
          "spf": {
            "present": true
          },
          "dmarc": {
            "present": true,
            "policy": "reject"
          },
          "dkim": {
            "present": true
          }
        }
      },
      "expected_header_strength": {
        "strict-transport-security": "weak"
      },
      "expected_finding_ids_absent": ["header_missing_strict_transport_security"],
      "note": "HSTS is present (max-age=3600) so header_missing_strict_transport_security must NOT be generated. Weak HSTS appears in header_strength as evidence metadata only. No scored finding in v4."
    },
