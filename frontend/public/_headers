# Cloudflare Pages header rules. All matching blocks apply top-to-bottom;
# `! Header-Name` detaches a header inherited from an earlier match.

# ── Every response: security headers + entrypoint no-cache ────────────────
# The Cache-Control here is written for index.html. It must live under /*
# (not /index.html) because the SPA fallback in _redirects serves index.html
# for deep links like /dashboard, and header rules match the REQUEST path,
# not the file served. Asset paths detach and override it below.
# The CSP allows the cookieless analytics beacon (script from
# static.cloudflareinsights.com, reports to cloudflareinsights.com) site-wide.
# The edge adds the beacon to every HTML response on both production hosts; no
# code in this app loads it (the manual snippet was removed on 19 Oct 2026 as a
# duplicate). Without these two origins the browser would block that beacon.
# challenges.cloudflare.com (script and frame) is the Turnstile human check on
# the free tools (/tools/*); it needs no connect-src or style origin.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://js.stripe.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.cybermeters.com https://api.stripe.com https://cloudflareinsights.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://app.cybermeters.com https://checkout.stripe.com; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ── Search engines: the public site, plus pricing and the free scan ───────
# One Pages project serves both hosts, so these rules match on the host. The
# app host (sign-in and the product) and every preview or staging host carry
# noindex. Pricing and the free scan live only on the app host and stay
# indexable (founder, 19 Oct 2026): the two rules below detach the header. The
# same list is in src/publicPages.js (indexable: true). robots.txt
# deliberately does not block these hosts: a crawler that may not fetch a page
# never sees its noindex.
https://app.cybermeters.com/*
  X-Robots-Tag: noindex

https://app.cybermeters.com/pricing
  ! X-Robots-Tag

https://app.cybermeters.com/free-scan
  ! X-Robots-Tag

https://app-staging.cybermeters.com/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# ── Hashed build output: cache forever ────────────────────────────────────
# Vite content-hashes every filename in /assets, so a URL's content can
# never change — safe for browsers and the CDN to keep for a year without
# revalidation. New deploys produce new URLs referenced by a fresh
# index.html, which is never cached (rule above).
/assets/*
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=31536000, immutable

# ── Self-hosted web fonts ─────────────────────────────────────────────────
# Without this rule the fonts inherited no-store from /* and every visit
# downloaded them again. A font file's content never changes under its name
# (a new cut gets a new file name), so a long cache is safe.
/fonts/*
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=31536000, immutable

# ── Stable-name static files (NOT content-hashed) ─────────────────────────
# These can change between deploys under the same URL, so cache briefly
# instead of immutably.
/favicon.ico
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=86400

/favicon.svg
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=86400

/og-image-v2.png
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=86400

# ── RFC 9116 vulnerability disclosure ─────────────────────────────────────
# Explicit text/plain content-type so scanners accept it; short cache.
/.well-known/security.txt
  ! Cache-Control
  ! Pragma
  ! Expires
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# ── Microsoft Entra publisher-domain verification ─────────────────────────
# Proves ownership of this domain for the Azure AD app registration's Publisher
# domain (and, with MPN association, the verified-publisher badge on the OAuth
# consent screen). applicationId is the app's public client ID. Must be served
# as application/json for Microsoft's verifier to accept it.
/.well-known/microsoft-identity-association.json
  ! Cache-Control
  ! Pragma
  ! Expires
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
