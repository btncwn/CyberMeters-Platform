# Cloudflare Pages header rules. All matching blocks apply top-to-bottom;
# `! Header-Name` detaches a header inherited from an earlier match.

# ── Every response: security headers + entrypoint no-cache ────────────────
# The Cache-Control here is written for index.html. It must live under /*
# (not /index.html) because the SPA fallback in _redirects serves index.html
# for deep links like /dashboard, and header rules match the REQUEST path,
# not the file served. Asset paths detach and override it below.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cybermeters-platform.ttrnn47.workers.dev https://api.cybermeters.com https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://checkout.stripe.com; worker-src 'self' blob:
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ── Hashed build output: cache forever ────────────────────────────────────
# Vite content-hashes every filename in /assets, so a URL's content can
# never change — safe for browsers and the CDN to keep for a year without
# revalidation. New deploys produce new URLs referenced by a fresh
# index.html, which is never cached (rule above).
/assets/*
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=31536000, immutable

# ── Stable-name static files (NOT content-hashed) ─────────────────────────
# These can change between deploys under the same URL, so cache briefly
# instead of immutably.
/favicon.ico
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=86400

/favicon.svg
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=86400

/og-image.png
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=86400

# ── RFC 9116 vulnerability disclosure ─────────────────────────────────────
# Explicit text/plain content-type so scanners accept it; short cache.
/.well-known/security.txt
  ! Cache-Control
  ! Pragma
  ! Expires
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
