# CyberMeters frontend — build-time configuration.
#
# Copy to `.env` and set the value for your environment:
#   cp frontend/.env.example frontend/.env
#
# `.env` is gitignored; this template is committed. Vite never reads this file — it
# documents the contract, and `scripts/validate-frontend-env-contract.js` keeps it
# matching what the code actually reads.
#
# NEVER put a secret here or in `.env`. Every VITE_* value is inlined into the client
# bundle at build time and is therefore public. Worker secrets are set with
# `wrangler secret put` and never appear in frontend configuration.

# Base URL of the CyberMeters API. Required — `src/api.js` reads it at build time and
# builds every request on it. There is no fallback: unset, the app loads but no API
# call can succeed.
#
# It MUST include the trailing `/api` path segment. Requests are built as
# `${BASE}${path}` with a bare path (e.g. `/auth/login`), so the `/api` prefix comes
# from this value — the API serves `https://api.cybermeters.com/api/auth/login`.
# Do not add `/api` to the request paths as well: that produces `/api/api/...` → 404
# (guarded by `src/__tests__/api-base.test.js`).
#
# In production this is supplied by the Cloudflare Pages build-environment settings,
# not by a file in the repository.
VITE_API_BASE_URL=https://api.cybermeters.com/api
